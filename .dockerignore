# 版本控制
.git
.gitignore
.gitattributes

# 依赖与构建产物（容器内重新生成）
node_modules
**/node_modules
dist
**/dist
docs-dist
**/docs-dist
packages/*/docs-dist
packages/*/dist

# 缓存与日志
.cache
.npm
.pnpm-store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / 编辑器
.vscode
.idea
*.swp
.DS_Store

# Docker 自身（避免循环 COPY）
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.yaml

# 文档与示例输出
.dumi/tmp
.dumi/production
.tmp

# 本地环境变量
.env
.env.local
.env.*.local
