{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@features/*": ["src/features/*"],
      "@pages/*": ["src/pages/*"],
      "@hooks/*": ["src/hooks/*"],
      "@ui/components": ["packages/ui/src"],
      "@ui/components/*": ["packages/ui/src/*"],
      "@utils/method": ["packages/utils/src"],
      "@utils/method/*": ["packages/utils/src/*"],
      "@maxgraph/shared": ["packages/maxgraph/src"],
      "@maxgraph/shared/*": ["packages/maxgraph/src/*"]
    }
  },
  "include": ["src", "packages", "src/**/*.d.ts", "packages/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "packages/**/dist", "packages/**/.dumi"]
}
